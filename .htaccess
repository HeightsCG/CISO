RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l

RewriteRule ^(.+)$ /index.php?url=$1 [QSA,L]

Options -Indexes

Header always set X-Frame-Options SAMEORIGIN
Header always set X-Content-Type-Options nosniff
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"

# The document root is meant to be public/. This is defence in depth for a
# misconfigured vhost that serves the repository root directly: the config,
# dependency manifests, importer and source tree must never be downloadable.
<FilesMatch "\.(ini|lock|json|xlsx|sql|sh|md|log)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(app|libs|vendor|sql)(/.*)?$
RedirectMatch 403 ^/import_standards\.php$