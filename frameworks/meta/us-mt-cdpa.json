    "consequences": [
        {
            "summary": "A violation that continues after the 30-day cure period carries a civil penalty of up to $7,500 for each violation.",
            "source": "mca2820",
            "cite": "MCA 30-14-2820(2)",
            "quote": "liable for a civil penalty in an amount not to exceed $7,500"
        }
    ],
    "glossary": [
        {
            "term": "MCDPA",
            "definition": "The Montana Consumer Data Privacy Act, Montana's comprehensive consumer privacy law, in force since 1 October 2024 and amended in 2025."
        },
        {
            "term": "Controller",
            "definition": "The person that, alone or jointly with others, determines the purpose and means of processing personal data."
        },
        {
            "term": "Processor",
            "definition": "A person that processes personal data on behalf of a controller."
        },
        {
            "term": "Sensitive data",
            "definition": "Personal data revealing racial or ethnic origin, religious beliefs, health diagnosis, sexual orientation, citizenship or immigration status; genetic or biometric data used to identify a person; data of a known child; and precise geolocation data."
        },
        {
            "term": "Data protection assessment",
            "definition": "A documented assessment, required before targeted advertising, sale of personal data, certain profiling and processing of sensitive data, that weighs the benefits of processing against the risks to consumers."
        }
    ]
