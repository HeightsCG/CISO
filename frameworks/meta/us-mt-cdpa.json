    "rules": [
        {
            "id": "objective_rollup",
            "type": "rollup",
            "summary": "A requirement is met only when every element it lists is met.",
            "source": "mca2808",
            "cite": "MCA 30-14-2808 to 30-14-2819"
        },
        {
            "id": "thresholds",
            "type": "applicability",
            "summary": "The Act applies to a business that does business in Montana or targets Montana residents and controls or processes personal data of at least 25,000 consumers, or of at least 15,000 while deriving over 25% of gross revenue from selling personal data. The minors' provisions (2811, 2818, 2819) apply regardless of those thresholds.",
            "source": "mca2803",
            "cite": "MCA 30-14-2803(1)",
            "quote": "control or process the personal data of not less than 25,000 consumers"
        },
        {
            "id": "request_deadline",
            "type": "deadline",
            "control": "30-14-2808(4)",
            "days": 45,
            "from": "receipt of the request",
            "summary": "A consumer request is answered without undue delay and within 45 days of receipt; the period may be extended once by 45 days.",
            "source": "mca2808",
            "cite": "MCA 30-14-2808(4)(a)",
            "quote": "not later than 45 days after receipt of the request"
        },
        {
            "id": "appeal_deadline",
            "type": "deadline",
            "control": "30-14-2808(5)",
            "days": 60,
            "from": "receipt of the appeal",
            "summary": "An appeal is decided and answered in writing within 60 days of receipt.",
            "source": "mca2808",
            "cite": "MCA 30-14-2808(5)",
            "quote": "Not later than 60 days after receipt of an appeal, a controller shall inform the consumer in writing"
        }
    ],
